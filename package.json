{
  "name": "@stahl/inox-ui",
  "version": "0.1.8",
  "description": "Design system Stahl — tokens CSS universales + componentes Svelte",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run package",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./style/main.scss": "./style/main.scss",
    "./style/tokens.scss": "./style/tokens.scss",
    "./style/components.scss": "./style/components.scss",
    "./style/themes/*": "./style/themes/*",
    "./style/fonts/*": "./style/fonts/*",
    "./style/components/*": "./style/components/*"
  },
  "files": [
    "dist",
    "src/lib",
    "style",
    "assets"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "publint": "^0.3.12",
    "sass": "^1.89.0",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
